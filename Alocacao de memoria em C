
#include <stdio.h>
#include <stdlib.h>//biblioteca responsavel pelo gerenciamento de memoria 

//malloc() — aloca memória sem inicializar os valores.
//calloc() — aloca memória e inicializa os bytes com zero.
//realloc() — altera o tamanho de uma memória já alocada.
//free() — libera a memória reservada.

struct Registro {
    int id;//guarda o numero de identificacao do registro
    int valor;// guarda o valor associado a esse registro 
};

int main() {
	//controlam a quantidade de registros
    int N = 2;//representa os registros iniciais
    int M = 5;//representa os registros extras
    int T = 7;//determina o tamanho final desejado do vetor
    int i;

    struct Registro *registros;

    // Alocacao inicial com calloc
    //ira alocar dinamicamente a memoria dos dois registros iniciais 
    registros = calloc(N, sizeof(struct Registro));
    //(calloc) reserva memória e inicializa os bytes com zero.
    //N(2) quantidade de elementos que queremos guardar 
    //SIZEOF calcula o tamanho de cada elemento

    if (registros == NULL) {
        printf("Erro na alocacao inicial de memoria!\n");
        return 1;
        //verifica se a alocacao funcionou, se o ponteiro for NULL apresenta uma msg de erro e encerra
    }

    // Preenchimento dos registros iniciais
    printf("\n--- Registros iniciais ---\n");

    for (i = 0; i < N; i++) {
        printf("\nDigite o ID do registro %d: ", i + 1);
        scanf("%d", &registros[i].id);

        printf("Digite o valor do registro %d: ", i + 1);
        scanf("%d", &registros[i].valor);
        //A cada repetição, atribui um ID e calcula o valor do registro, o índice começa em zero e percorre as posições do vetor.
    }

    struct Registro *extras;

    // Alocacao temporaria com malloc
    extras = malloc(M * sizeof(struct Registro));
    //(malloc) - o malloc reserva espaço para M registros extras, mas não inicializa o conteúdo da memória.

    if (extras == NULL) {
        printf("Erro na alocacao dos registros extras!\n");
        free(registros);
        return 1;
    }

    // Preenchimento dos registros extras
    printf("\n--- Registros extras ---\n");

    for (i = 0; i < M; i++) {
        printf("\nDigite o ID do registro extra %d: ", i + 1);
        scanf("%d", &extras[i].id);

        printf("Digite o valor do registro extra %d: ", i + 1);
        scanf("%d", &extras[i].valor);
    }

    //Expande o vetor principal para receber os registros extras
    struct Registro *temporario;

    temporario = realloc(
        registros, T * sizeof(struct Registro)
        //realloc aumenta o valor principal (2), que antes comportava dois registros, para comportar sete (+ M) 
		//o resultado e guardado em temporario para verificar se a operação foi bem-sucedida. Se funcionar, atualiza o ponteiro registros.
    );

    if (temporario == NULL) {
        printf("Erro ao expandir o vetor principal!\n");
        free(extras);
        free(registros);
        return 1;
        // se a alocacao falhar, libera os dois blocos que ainda estao alocados
    }

    registros = temporario;

    // Copia os registros extras para o vetor principal
    for (i = 0; i < M; i++) {
        registros[N + i] = extras[i];
    }

    // Libera a memoria temporaria
    free(extras);

    // Exibe os registros cadastrados
    printf("\n--- Conteudo final do vetor ---\n");

    for (i = 0; i < T; i++) {
        printf(
            "Registro %d | ID: %d | Valor: %d\n",
            i + 1,
            registros[i].id,
            registros[i].valor
        );
    }

    // Libera a memoria principal
    free(registros);

    printf("\nMemoria liberada com sucesso!\n");

    return 0;
}
