#include <stdio.h>

int main(){
	printf("---Alfabeto com WHILE---\n\n");
	printf("Letra | Codigo ASCII\n");
	printf("----------------------\n");
	
	//1.inicializacao da variavel do tipo char antes do while 
	char letra = 'A';
	
	//2.condicao: o loop roda enquanto a letra for menor ou igual a 'Z'
	while (letra <= 'Z') {
		//exibe a letra e o seu codigo ASCII correspondente 
		printf("%c | %d\n", letra, (int)letra);
		
		//3.incremento: passa para a proxima letra do alfabeto
		letra++;
	}
	return 0;
}
